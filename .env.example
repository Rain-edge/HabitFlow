# ===== HabitFlow Environment Variables =====
# Copy this file to .env and fill in real values. NEVER commit .env to Git.

# --- App ---
APP_ENV=development
APP_NAME=HabitFlow
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Database (PostgreSQL) ---
POSTGRES_USER=habitflow
POSTGRES_PASSWORD=habitflow_password
POSTGRES_DB=habitflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://habitflow:habitflow_password@postgres:5432/habitflow

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Scheduler / Notifications ---
ENABLE_SCHEDULER=true

# --- Seed / Demo ---
SEED_DEMO_DATA=false
